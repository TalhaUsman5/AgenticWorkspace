#!/usr/bin/env bash
# tmux stub.
#   TMUX_ALIVE=1       `has-session` succeeds
#   TMUX_CMD_LOG       if set, every invocation is appended to this file, so a
#                      test can assert what the monitor sent to the session
#   TMUX_PANE_OUTPUT   if set, `capture-pane` prints this text (only while
#                      TMUX_ALIVE=1 - a dead session has nothing to capture)
#   TMUX_PANE_COMMAND  what `list-panes -F '#{pane_current_command}'` reports
#                      while TMUX_ALIVE=1 - defaults to "claude" so tests that
#                      don't care about liveness detection keep seeing a live
#                      agent. Set to "bash" (or any non-"claude" value) to
#                      simulate the agent process having exited while the
#                      session itself survives.
#   TMUX_LIST_PANES_FAIL if set, `list-panes` exits non-zero instead of
#                      reporting a command, simulating an inconclusive check.
#   TMUX_LIST_PANES_HANG if set, `list-panes` sleeps well past any timeout
#                      the caller could reasonably set, simulating a wedged
#                      tmux server rather than a dead agent.
[ -n "${TMUX_CMD_LOG:-}" ] && echo "$*" >> "$TMUX_CMD_LOG"
case "$1" in
  has-session) [ "${TMUX_ALIVE:-0}" = "1" ] ;;
  capture-pane)
    if [ "${TMUX_ALIVE:-0}" = "1" ] && [ -n "${TMUX_PANE_OUTPUT:-}" ]; then
      printf '%s\n' "$TMUX_PANE_OUTPUT"
    fi
    ;;
  list-panes)
    if [ "${TMUX_LIST_PANES_HANG:-0}" = "1" ]; then
      # `exec` rather than a plain `sleep 300`: the real tmux binary this
      # stands in for is a single process, so killing it releases its stdout
      # fd immediately. A plain `sleep 300` forks a grandchild that would
      # survive the parent being killed, keep holding this script's stdout
      # open, and block any caller reading it via command substitution for
      # the full 300s regardless of the watchdog.
      exec sleep 300
    fi
    if [ "${TMUX_LIST_PANES_FAIL:-0}" = "1" ]; then
      exit 1
    fi
    if [ "${TMUX_ALIVE:-0}" = "1" ]; then
      printf '%s\n' "${TMUX_PANE_COMMAND:-claude}"
    fi
    ;;
  new-session|send-keys|kill-session) echo "[tmux stub] $*" >&2 ;;
  *) exit 0 ;;
esac
